@model List<FoodDeliveryWebApplication.WebMvcApp.Entities.Product>
@{
    ViewData["Title"] = "Menu";
    ViewData["BodyClass"] = "home";
}

<!-- Top right -->
<div class="top-actions">
    <button class="icon-chip" type="button" onclick="App.openCart()" aria-label="Košík">
        <span class="cart-ico">🛒</span>
        <span class="badge" id="cartCount">0</span>
    </button>

    <button class="chip chip-user" type="button" onclick="App.toggleUserMenu()">
        @(User.FindFirst("email")?.Value ?? "Uživatel")
    </button>

    <div id="userMenu" class="user-menu" hidden>
        <button type="button" class="user-item">Profil</button>
        <button type="button" class="user-item">Moje objednávky</button>
        <button type="button" class="user-item">Nastavení</button>
        <div class="user-sep"></div>

        <!-- DŮLEŽITÉ: žádný App.logout() -->
        <form method="post" asp-controller="Home" asp-action="Logout">
            <button type="submit" class="user-item danger">Odhlásit se</button>
        </form>

    </div>
</div>


<!-- Hero -->
<header class="hero">
    <div class="hero-inner">
        <div class="hero-brand">
            <span class="hero-icon" aria-hidden="true">🍴</span>
            <div>
                <h1 class="hero-title">FoodExpress</h1>
                <p class="hero-sub">Rychlý rozvoz jídla přímo k Vám domů</p>
            </div>
        </div>

        <div class="hero-search">
            <span class="search-ico" aria-hidden="true">🔍</span>
            <input id="searchInput" type="text" placeholder="Hledat jídlo..." />
        </div>
    </div>
</header>

<!-- Categories -->
<section class="cats">
    <div class="cats-inner" id="categoryTabs"></div>
</section>

<!-- Grid -->
<div class="container">
    <div id="foodGrid" class="grid">
        @foreach (var item in Model)
        {
            <article class="card"
                     data-product
                     data-id="@item.Id"
                     data-name="@item.Name"
                     data-description="@item.Description"
                     data-price="@item.Price"
                     data-image="@item.ImageUrl"
                     data-category="@item.CategoryId">

                <div class="card-media js-open" data-open="@item.Id">
                    <img src="@item.ImageUrl" alt="@item.Name" />
                </div>

                <div class="card-body">
                    <h3 class="card-title js-open" data-open="@item.Id">@item.Name</h3>
                    <p class="card-desc">@item.Description</p>

                    <div class="card-row">
                        <span class="card-price">@item.Price Kč</span>
                        <button class="btn-add" type="button" data-add="@item.Id">Přidat</button>
                    </div>
                </div>
            </article>
        }
    </div>

    <div id="emptyState" class="empty" hidden>Nenalezeno žádné jídlo</div>
</div>

<footer class="footer">
    © 2026 FoodExpress. Všechna práva vyhrazena.
</footer>

<!-- CART drawer -->
<div id="cartOverlay" class="overlay" hidden onclick="App.closeCart()"></div>

<aside id="cartDrawer" class="drawer" hidden>
    <div class="drawer-head">
        <h2>Váš Košík</h2>
        <button class="drawer-close" type="button" onclick="App.closeCart()">×</button>
    </div>

    <div id="cartBody" class="drawer-body"></div>

    <div class="drawer-foot">
        <div class="drawer-total">
            <span>Celkem:</span>
            <strong><span id="cartTotal">0</span> Kč</strong>
        </div>

        <a class="drawer-cta" asp-controller="FoodExpress" asp-action="Checkout">
            <h3 style="margin-left: 100px; margin-top: 9px">Přejít k platbě </h3>
        </a>
    </div>
</aside>

<!-- DETAIL modal -->
<div id="detailOverlay" class="overlay" hidden onclick="App.closeDetail()"></div>

<section id="detailModal" class="detail" hidden aria-label="Detail jídla">
    <button class="detail-close" type="button" onclick="App.closeDetail()">×</button>

    <h2 id="dTitle" class="detail-title"></h2>

    <div class="detail-image">
        <img id="dImg" alt="" />
    </div>

    <div class="detail-toprow">
        <div class="detail-priceblock">
            <div class="detail-price"><span id="dPrice"></span> Kč</div>
            <div class="detail-rating">
                <span class="star">★</span>
                <span id="dRating"></span>
                <span class="muted">(<span id="dReviewCount"></span> recenzí)</span>
            </div>
        </div>

        <button class="detail-add" type="button" onclick="App.addSelectedToCart()">
            <span class="plus">＋</span> Přidat do košíku
        </button>
    </div>

    <div class="detail-stats">
        <div class="stat">
            <div class="stat-ico">⏱</div>
            <div>
                <div class="stat-label">Příprava</div>
                <div class="stat-val" id="dPrep"></div>
            </div>
        </div>
        <div class="stat">
            <div class="stat-ico">🔥</div>
            <div>
                <div class="stat-label">Kalorie</div>
                <div class="stat-val" id="dCal"></div>
            </div>
        </div>
        <div class="stat">
            <div class="stat-ico">☆</div>
            <div>
                <div class="stat-label">Hodnocení</div>
                <div class="stat-val"><span id="dRating2"></span> / 5.0</div>
            </div>
        </div>
    </div>

    <div class="detail-section">
        <h3>Popis</h3>
        <p id="dDesc"></p>
    </div>

    <div class="detail-section" id="allergenWrap" hidden>
        <h3>Alergeny</h3>
        <div class="badges" id="dAllergens"></div>
    </div>

    <hr class="sep" />

    <div class="detail-section">
        <h3>Recenze (<span id="dReviewCount2"></span>)</h3>
        <div id="dReviews" class="reviews"></div>
    </div>
</section>
